{
  "name": "lumina",
  "version": "1.0.0",
  "description": "LUMINA - plataforma de streaming. Práctica Bootstrap 5.3 + Sass",
  "scripts": {
    "build": "sass scss/style.scss css/style.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions",
    "build:min": "sass scss/style.scss css/style.min.css --style=compressed --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions",
    "watch": "sass --watch scss/style.scss css/style.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.93.2"
  }
}
